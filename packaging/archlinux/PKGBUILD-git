# Maintainer: mplx <jennifer@mplx.dev>

# jvc is architecture-independent Jennifer source, so the package copies the
# two directories the launcher needs, plus the completions and the docs.
#
# `jennifer-bin` and `jennifer-git` both provide an unversioned `jennifer`, so
# the sources' floor (`# pragma-jennifer-version: >=0.25.0`) cannot be written
# here as `jennifer>=0.25.0`: it would be unsatisfiable. The interpreter checks
# the pragma at load time instead; a `-dev` build bypasses it, a release such
# as 0.25.0 is checked.

_pkgname=jvc
pkgname=jvc-git
pkgver=0.1.0.r4.g3e6f8b4
pkgrel=1
pkgdesc="The Jennifer deck manager: dependency resolution, vendoring, and publishing for Jennifer projects"
arch=('any')
url="https://github.com/jennifer-language/jvc"
license=('LGPL-3.0-only')
depends=('jennifer')
# git fetches the source, and check() needs it too: several overlays run the
# real binary. At run time it is optional, as in PKGBUILD and the .deb.
makedepends=('git')
optdepends=(
	'git: [sources] decks, registry decks of kind git, `jvc app install`, and publishing'
)
provides=("${_pkgname}=${pkgver%%.r*}")
conflicts=("${_pkgname}")
source=("${_pkgname}::git+https://github.com/jennifer-language/jvc.git")
sha256sums=('SKIP')

pkgver() {
	cd "${srcdir}/${_pkgname}"

	# The manifest's version plus the revision count keeps builds ordered.
	# TODO: once release tags exist, derive this from `git describe` instead.
	local ver
	ver="$(sed -n 's/^version = "\(.*\)"/\1/p' deck.toml | head -n1)"
	printf '%s.r%s.g%s' "${ver:-0}" "$(git rev-list --count HEAD)" \
		"$(git rev-parse --short=7 HEAD)"
}

check() {
	cd "${srcdir}/${_pkgname}"

	# Every module has a white-box overlay, which `jennifer test` runs with
	# the module spliced in. Globbed, as in CI, so a new module cannot skip
	# its tests.
	local t
	for t in src/*_test.j; do
		jennifer test "${t}"
	done

	jennifer lint src/*.j bin/jvc
}

package() {
	cd "${srcdir}/${_pkgname}"

	# The launcher imports "../src/cli.j" relative to its own file, so `bin/`
	# and `src/` stay siblings, under `/usr/share` as an
	# architecture-independent tree.
	install -Dm755 bin/jvc "${pkgdir}/usr/share/jvc/bin/jvc"
	install -Dm644 deck.toml "${pkgdir}/usr/share/jvc/deck.toml"

	# The test overlays are not shipped: nothing imports them at runtime.
	local f
	for f in src/*.j; do
		[[ ${f} == *_test.j ]] && continue
		install -Dm644 "${f}" "${pkgdir}/usr/share/jvc/${f}"
	done

	# A symlink, as `jvc app install` writes: the interpreter resolves the
	# relative import through it.
	install -dm755 "${pkgdir}/usr/bin"
	ln -s /usr/share/jvc/bin/jvc "${pkgdir}/usr/bin/jvc"

	install -Dm644 completions/jvc.bash \
		"${pkgdir}/usr/share/bash-completion/completions/jvc"
	install -Dm644 completions/jvc.fish \
		"${pkgdir}/usr/share/fish/vendor_completions.d/jvc.fish"

	install -Dm644 README.md -t "${pkgdir}/usr/share/doc/${_pkgname}"
	install -Dm644 docs/cli.md docs/manifest.md docs/deck-spec.md \
		-t "${pkgdir}/usr/share/doc/${_pkgname}"
}
