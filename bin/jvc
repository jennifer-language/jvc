# jvc - the jennifer deck manager. A thin launcher over the `cli` module, which
# holds all the logic and its tests. Run it directly:
#
#     ./jvc install
#
# or through the interpreter: `jennifer run jvc install`.

use os;
import "../src/cli.j" as cli;

def code as int init cli.main(os.ARGS);
exit $code;
